! SCF pristine graphene unit cell (7x7 k grid, no sym reduction)
&CONTROL
  calculation = 'scf'
  prefix      = 'defect_unit_cell_7x7_wann'
  outdir      = '/home/gregb26/links/scratch/qe_tmp/defect_unit_cell_7x7_wann'
  pseudo_dir  = '/home/gregb26/links/projects/rrg-cotemich-ac/gregb26/abinit_processing/pseudo'
/
&SYSTEM
  ibrav=0
  nat=2
  ntyp=1
  ecutwfc=100
  occupations='smearing'
  smearing='mv'
  degauss=0.01
  nbnd=16
  assume_isolated='2D'
  nosym=.true.
  noinv=.true.
/
&ELECTRONS
  electron_maxstep=400
  conv_thr=1.d-14
  mixing_beta=0.3
/
ATOMIC_SPECIES
  C 12.011 C.upf
CELL_PARAMETERS bohr
  4.0354919061  -2.3298923383   0.0
  4.0354919061   2.3298923383   0.0
  0.0            0.0           30.0
ATOMIC_POSITIONS crystal
  C  0.3333333333  0.3333333333  0.0
  C  0.6666666667  0.6666666667  0.0
K_POINTS automatic
7 7 1 0 0 0
