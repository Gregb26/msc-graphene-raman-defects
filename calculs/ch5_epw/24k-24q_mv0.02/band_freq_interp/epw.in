! P18 : chaine 24k-24q_mv0.02 (degauss 0.02 Ry), entree identique a 24k-24q sauf fermi_energy = E_D de cette chaine
! restarting from real space quantities and interpolating on same grid as DFT and DFPT to verify convergence

&INPUTEPW
  prefix        = 'graphene'
  outdir        = './'
  dvscf_dir     = '../phonons/save'

  etf_mem       = 0

  elph          = .true.              ! enable electron-phonon properties
  epwread       = .true.              ! restart from real space quantities

  wannierize    = .false.             ! do not do another Wannierization
  nbndsub       = 5

  band_plot     = .true.
  fsthick       = 100                 ! eV, should be large for bandstructure plot

  filkf         = 'graphene_band.kpt' ! file containing fine kpath for interpolation. use the same as the DFT band structure to compare
  filqf         = 'graphene_band.kpt' ! file containing fine qpath for interpolation. use same as DFPT phonon calculation

  ! coarse grids
  nk1           = 24
  nk2           = 24
  nk3           = 1
  nq1           = 24
  nq2           = 24
  nq3           = 1
/

