! P18 : chaine 24k-24q_mv0.02 (degauss 0.02 Ry), entree identique a 24k-24q sauf fermi_energy = E_D de cette chaine
! P2 : self-energie electronique (elecselfen) sur grille fine 240x240 k = q, T = 10 K, degaussw 0.02 eV
! reference d'energie : fermi_energy = E_D (Wannier, chapitre 4) ; fenetre fsthick 3.5 eV ; Gamma^ep = 2 Im Sigma

&INPUTEPW
  prefix        = 'graphene'
  outdir        = './'
  dvscf_dir     = '../phonons/save'

  etf_mem       = 1

  elph          = .true.
  epwread       = .true.
  epwwrite      = .false.
  wannierize    = .false.
  nbndsub       = 5

  elecselfen    = .true.
  efermi_read   = .true.
  fermi_energy  = -4.2389
  fsthick       = 3.5
  temps         = 10
  nstemp        = 1
  degaussw      = 0.02
  ngaussw       = 0

  mp_mesh_k     = .true.
  restart       = .true.
  restart_step  = 1000

  nkf1          = 240
  nkf2          = 240
  nkf3          = 1
  nqf1          = 240
  nqf2          = 240
  nqf3          = 1

  nk1           = 24
  nk2           = 24
  nk3           = 1
  nq1           = 24
  nq2           = 24
  nq3           = 1
/
