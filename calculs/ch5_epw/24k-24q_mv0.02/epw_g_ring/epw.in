! P18 : chaine 24k-24q_mv0.02 (degauss 0.02 Ry), entree identique a 24k-24q sauf fermi_energy = E_D de cette chaine
! P11 test : |g| prtgkk pour k sur deux anneaux autour de K (rayons hbar*omega/2v des modes E2g et A1', 12 angles chacun), q = Gamma et q = K
&INPUTEPW
  prefix        = 'graphene'
  outdir        = './'
  dvscf_dir     = '../phonons/save'
  etf_mem       = 1
  elph          = .true.
  epwread       = .true.
  epwwrite      = .false.
  wannierize    = .false.
  nbndsub       = 5
  prtgkk        = .true.
  filkf         = 'ring.kpt'
  filqf         = 'GK.kpt'
  nk1 = 24, nk2 = 24, nk3 = 1
  nq1 = 24, nq2 = 24, nq3 = 1
/
