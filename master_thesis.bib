  date = {2011},
  publisher = {Springer/Sci-Tech/Trade},
  location = {Berlin ; Heidelberg},
  abstract = {Ce manuel vise à permettre aux lecteurs de comprendre les aspects fondamentaux sous-jacents aux phénomènes macroscopiques quantiques dans les solides, principalement à travers les techniques expérimentales et les résultats modernes. L'approche classique des électrons indépendants pour décrire la structure électronique en termes de bandes d'énergie aide à expliquer l'apparition de métaux, d'isolateurs et de semi-conducteurs. Il est souligné que la supraconductivité et le magnétisme ne peuvent être compris qu'en prenant en compte les interactions entre les électrons. Le texte retrace les observations expérimentales qui ont révélé les principales propriétés des supraconducteurs et ont été essentielles pour suivre son origine physique. Bien que les concepts fondamentaux soient soulignés, ceux qui sont nécessaires pour décrire les applications de haute technologie, présentes ou futures, sont également soulignés. Les ensembles de problèmes impliquent des approches expérimentales et des outils qui soutiennent une compréhension pratique des matériaux et de leur comportement.},
  isbn = {978-3-642-13564-4},
  langid = {Anglais},
  pagetotal = {618}
}

@article{anisimovBandTheoryMott1991,
  title = {Band Theory and {{Mott}} Insulators: {{Hubbard U}} Instead of {{Stoner I}}},
  shorttitle = {Band Theory and {{Mott}} Insulators},
  author = {Anisimov, Vladimir I. and Zaanen, Jan and Andersen, Ole K.},
  date = {1991-07-15},
  journaltitle = {Physical Review B},
